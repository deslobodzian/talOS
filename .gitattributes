# LF everywhere, whatever core.autocrlf says: tests that edit TOML as strings
# fail on CRLF (e.g. a Windows checkout read from WSL through /mnt/c).
* text=auto eol=lf

# Shell scripts must keep LF or bash (incl. WSL) fails with $'\r'.
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.jar binary
*.so binary
*.dylib binary
*.dll binary
*.woff binary
*.woff2 binary
*.ttf binary
