load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//talOS/build:contract.bzl", "talos_messages")

# A recorded session's index, channels, series and snapshots, the review API
# over them, and the Host, CORS and static-file decisions, each as a function
# of a request: everything but the socket.
cc_library(
    name = "review",
    srcs = [
        "hardware_channels.cc",
        "http.cc",
        "review.cc",
        "session.cc",
    ],
    hdrs = [
        "hardware_channels.h",
        "http.h",
        "review.h",
        "series_cache.h",
        "session.h",
    ],
    deps = [
        "//studio/bridge:system",
        "//studio/bridge:telemetry",
        "//talOS/events:events_core",
        "//talOS/events:events_log",
        "//talOS/launcher:hardware_record",
        "//talOS/launcher:log_inputs",
        "//talOS/launcher:log_merge",
        "//talOS/launcher:session",
        "//talOS/schema:identity",
        "//talOS/schema:unit_suffix",
        "//talOS/telemetry:channels",
        "//talOS/telemetry:frames",
        "@flatbuffers//:runtime_cc",
        "@nlohmann_json//:json",
    ],
)

# studio_review --library DIR [--port 5805] [--cache-mb 256] [--webroot DIR];
# studio/README.md, "Reviewing a recorded session". Serves the Studio it was
# built with, from its runfiles.
cc_binary(
    name = "studio_review",
    srcs = ["main.cc"],
    data = ["//studio:web_dist"],
    local_defines = ["TALOS_WEB_DIST=\\\"$(rlocationpath //studio:web_dist)\\\""],
    visibility = ["//visibility:public"],
    deps = [
        ":review",
        "@rules_cc//cc/runfiles",
        "@studio_usockets//:usockets",
        "@studio_uws//:uws",
    ],
)

talos_messages(
    name = "review_test_message",
    srcs = ["testdata/review_message.fbs"],
    include_prefix = "review_test",
    visibility = ["//visibility:private"],
)

# The fixture session both tests read: two members, a rotated log, a
# restart, a damaged record, a schema'd topic and hardware packets.
cc_library(
    name = "fixture",
    testonly = True,
    srcs = ["testdata/fixture.cc"],
    hdrs = ["testdata/fixture.h"],
    deps = [
        ":review_test_message",
        "//talOS/driver_station",
        "//talOS/events:events_core",
        "//talOS/events:events_log",
        "//talOS/hardware",
    ],
)

# The review API's responses for the fixture session, byte for byte:
# review_test regenerates and compares them, and //studio:review_golden_test
# decodes them with studio/src/data/review.ts, so a shape change on either
# side fails the other side's test (studio/README.md, "Reviewing a
# session", says how to update them).
js_library(
    name = "golden",
    srcs = glob(["testdata/golden/*"]),
    visibility = ["//studio:__pkg__"],
)

# Values against log_dump --format jsonl, the golden responses, the index's
# seeks and bytes, the cache's bound, the session id check, a read-only
# library and the static files, with no socket.
cc_test(
    name = "review_test",
    size = "small",
    srcs = ["tests/review_test.cc"],
    data = ["//talOS/launcher:log_dump"] + glob(["testdata/golden/*"]),
    env = {
        "TALOS_GOLDEN_BOUNDS": "$(rlocationpath testdata/golden/bounds.json)",
        "TALOS_LOG_DUMP": "$(rlocationpath //talOS/launcher:log_dump)",
    },
    deps = [
        ":fixture",
        ":review",
        ":review_test_message",
        "//talOS/events:events_core",
        "//talOS/events:events_log",
        "@flatbuffers//:runtime_cc",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
        "@rules_cc//cc/runfiles",
    ],
)

# The binary over loopback: the HTTP shapes, the built Studio at /, the
# Host check and loopback-only CORS, and no listener off loopback.
cc_test(
    name = "http_test",
    size = "small",
    srcs = ["tests/http_test.cc"],
    data = [":studio_review"],
    env = {"TALOS_STUDIO_REVIEW": "$(rlocationpath :studio_review)"},
    deps = [
        ":fixture",
        "@googletest//:gtest_main",
        "@nlohmann_json//:json",
        "@rules_cc//cc/runfiles",
    ],
)

# Open time and peak resident memory on a generated session of at least
# 200 MB; run by hand on an idle host (README.md, "Reviewing a session").
cc_binary(
    name = "review_bench",
    testonly = True,
    srcs = ["tests/review_bench.cc"],
    deps = [
        ":review",
        ":review_test_message",
        "//talOS/events:events_core",
        "//talOS/events:events_log",
    ],
)
