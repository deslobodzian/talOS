load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@studio_npm//:defs.bzl", "npm_link_all_packages")
load("@studio_npm//studio:typescript/package_json.bzl", tsc_bin = "bin")
load("@studio_npm//studio:vite/package_json.bzl", vite_bin = "bin")

package(default_visibility = ["//visibility:public"])

exports_files([
    "package.json",
    "pnpm-lock.yaml",
])

npm_link_all_packages(name = "node_modules")

# One schema and the monorepo's flatc tool generate both C++ and TS bindings.
# Single contract home: //talOS/telemetry owns telemetry.fbs.
genrule(
    name = "telemetry_ts",
    srcs = ["//talOS/telemetry:telemetry.fbs"],
    outs = [
        "src/generated/talos/telemetry.ts",
        "src/generated/talos/telemetry/channel-info.ts",
        "src/generated/talos/telemetry/frame.ts",
        "src/generated/talos/telemetry/pose.ts",
    ],
    cmd = "$(location @flatbuffers//:flatc) --ts -o $(RULEDIR)/src/generated $(location //talOS/telemetry:telemetry.fbs)",
    tools = ["@flatbuffers//:flatc"],
)

js_library(
    name = "sources",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.css",
        "tests/*.ts",
        "tests/*.tsx",
        "tests/*.json",
        "agent/*.ts",
        "agent/*.mjs",
        "tests/*.mjs",
    ]) + [
        "index.html",
        "package.json",
        "tsconfig.json",
        ":telemetry_ts",
    ],
    deps = [":node_modules"],
)

vite_bin.vite_binary(
    name = "vite",
    chdir = "studio",
)

tsc_bin.tsc_test(
    name = "typecheck",
    args = [
        "--noEmit",
        "--project",
        "tsconfig.json",
    ],
    chdir = "studio",
    data = [":sources"],
)

js_run_binary(
    name = "web_dist",
    srcs = [":sources"],
    args = [
        "build",
        "--outDir",
        "dist",
    ],
    chdir = "studio",
    out_dirs = ["dist"],
    tool = ":vite",
)

vite_bin.vite_binary(
    name = "dev",
    chdir = "studio",
    data = [":sources"],
    fixed_args = [
        "--host",
        "127.0.0.1",
    ],
)

js_binary(
    name = "agent",
    chdir = "studio",
    data = [":sources"],
    entry_point = "agent/run.mjs",
)

js_test(
    name = "core_test",
    chdir = "studio",
    data = [":sources"],
    entry_point = "tests/run.mjs",
    fixed_args = ["core.test.ts"],
)

js_test(
    name = "agent_test",
    chdir = "studio",
    data = [":sources"],
    entry_point = "tests/run.mjs",
    fixed_args = ["agent.test.ts"],
)

# Renders the system-graph views with react-dom/server. A typecheck and a
# successful bundle prove the code compiles; this proves it runs.
js_test(
    name = "view_test",
    chdir = "studio",
    data = [":sources"],
    entry_point = "tests/run.mjs",
    fixed_args = ["view.test.tsx"],
)

js_test(
    name = "system_test",
    chdir = "studio",
    data = [":sources"],
    entry_point = "tests/run.mjs",
    fixed_args = ["system.test.ts"],
)

# The launcher writes the declared graph in C++ and system.ts parses it in
# TypeScript; neither language can check the other. This parses a document the
# launcher really produced, so a change to its envelope fails here.
js_test(
    name = "declared_test",
    chdir = "studio",
    data = [":sources"],
    entry_point = "tests/run.mjs",
    fixed_args = ["declared.test.ts"],
)

test_suite(
    name = "tests",
    tests = [
        ":agent_test",
        ":core_test",
        ":declared_test",
        ":system_test",
        ":typecheck",
        ":view_test",
        "//studio/bridge:system_test",
        "//talOS/telemetry:wire_test",
    ],
)
