load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_library", "js_run_binary", "js_test")
load("@studio_npm//:defs.bzl", "npm_link_all_packages")
load("@studio_npm//studio:typescript/package_json.bzl", tsc_bin = "bin")
load("@studio_npm//studio:vite/package_json.bzl", vite_bin = "bin")

package(default_visibility = ["//visibility:public"])

exports_files([
    "package.json",
    "pnpm-lock.yaml",
])

npm_link_all_packages(name = "node_modules")

# One schema and the monorepo's flatc tool generate both C++ and TS bindings.
# Single contract home: //talOS/telemetry owns telemetry.fbs.
genrule(
    name = "telemetry_ts",
    srcs = ["//talOS/telemetry:telemetry.fbs"],
    outs = [
        "src/generated/talos/telemetry.ts",
        "src/generated/talos/telemetry/channel-info.ts",
        "src/generated/talos/telemetry/channel-kind.ts",
        "src/generated/talos/telemetry/frame.ts",
        "src/generated/talos/telemetry/pose.ts",
    ],
    cmd = "$(execpath @flatbuffers//:flatc) --ts -o $(RULEDIR)/src/generated $(execpath //talOS/telemetry:telemetry.fbs)",
    tools = ["@flatbuffers//:flatc"],
)

js_library(
    name = "sources",
    srcs = glob([
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.css",
        "tests/*.ts",
        "tests/*.tsx",
        "tests/*.json",
        "agent/*.ts",
        "agent/*.mjs",
        "tests/*.mjs",
    ]) + [
        "index.html",
        "package.json",
        "tsconfig.json",
        ":telemetry_ts",
    ],
    deps = [":node_modules"],
)

vite_bin.vite_binary(
    name = "vite",
    chdir = "studio",
)

tsc_bin.tsc_test(
    name = "typecheck",
    args = [
        "--noEmit",
        "--project",
        "tsconfig.json",
    ],
    chdir = "studio",
    data = [":sources"],
)

js_run_binary(
    name = "web_dist",
    srcs = [":sources"],
    args = [
        "build",
        "--outDir",
        "dist",
    ],
    chdir = "studio",
    out_dirs = ["dist"],
    tool = ":vite",
)

vite_bin.vite_binary(
    name = "dev",
    chdir = "studio",
    data = [":sources"],
    fixed_args = [
        "--host",
        "127.0.0.1",
    ],
)

js_binary(
    name = "agent",
    chdir = "studio",
    data = [":sources"],
    entry_point = "agent/run.mjs",
)

# One node --test target per test file, run through tests/run.mjs (tsx + a
# CSS-import stub). Add a test file by adding one line here.
#
# patch_node_fs = False: rules_js's fs patches keep resolved paths inside the
# runfiles symlink tree, so tsx cannot match sources against tsconfig.json and
# compiles .tsx with the classic JSX transform ("React is not defined").
#
# view: renders views with react-dom/server; a typecheck and a bundle prove
# the code compiles, this proves it runs. declared: parses a graph document
# the C++ launcher really produced, so a change to its envelope fails here.
STUDIO_TESTS = {
    "agent_test": "agent.test.ts",
    "commands_test": "commands.test.ts",
    "core_test": "core.test.ts",
    "declared_test": "declared.test.ts",
    "discovery_test": "discovery.test.ts",
    "events_panel_test": "events_panel.test.tsx",
    "events_test": "events.test.ts",
    "field_test": "field.test.tsx",
    "formatters_test": "formatters.test.ts",
    "frames_test": "frames.test.ts",
    "hardware_test": "hardware.test.tsx",
    "hooks_test": "hooks.test.tsx",
    "inspector_test": "inspector.test.tsx",
    "layout_test": "layout.test.ts",
    "manifest_test": "manifest.test.ts",
    "panels_test": "panels.test.tsx",
    "plot_test": "plot.test.tsx",
    "recorded_test": "recorded.test.tsx",
    "review_golden_test": "review_golden.test.ts",
    "robot_panel_test": "robot_panel.test.tsx",
    "robot_test": "robot.test.ts",
    "session_test": "session.test.tsx",
    "store_test": "store.test.ts",
    "subsystems_test": "subsystems.test.tsx",
    "system_test": "system.test.ts",
    "view_test": "view.test.tsx",
    "vision_test": "vision.test.tsx",
    "worker_test": "worker.test.ts",
}

# A test's data beyond the sources. review_golden: the review server's golden
# responses, which //studio/review:review_test holds the server to. system:
# the Studio bridge's golden graph and update, which
# //studio/bridge:system_test holds the bridge to.
STUDIO_TEST_DATA = {
    "review_golden_test": ["//studio/review:golden"],
    "system_test": ["//studio/bridge:golden"],
}

[
    js_test(
        name = name,
        chdir = "studio",
        data = [":sources"] + STUDIO_TEST_DATA.get(name, []),
        entry_point = "tests/run.mjs",
        fixed_args = [test_file],
        patch_node_fs = False,
    )
    for name, test_file in STUDIO_TESTS.items()
]

test_suite(
    name = "tests",
    tests = [":" + name for name in STUDIO_TESTS] + [
        ":typecheck",
        "//studio/bridge:describe_test",
        "//studio/bridge:fast_slots_test",
        "//studio/bridge:integration_test",
        "//studio/bridge:system_test",
        "//studio/bridge:telemetry_test",
        "//talOS/telemetry:wire_test",
    ],
)
