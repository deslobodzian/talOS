load("@flatbuffers//:build_defs.bzl", "flatbuffer_cc_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
package(default_visibility = ["//visibility:public"])
exports_files(["telemetry.fbs"])
flatbuffer_cc_library(
    name = "telemetry_cc",
    srcs = ["telemetry.fbs"],
)
# The slot geometry is a contract between the bridge and whatever produces
# telemetry, so producers outside the bridge package need it too. It lives
# here, next to the frame schema, so the whole producer/bridge contract is one
# neutral package that neither the viewer nor a robot reaches past.
cc_library(name = "wire", hdrs = ["wire.h"])
cc_test(
    name = "wire_test",
    srcs = ["tests/wire_test.cc"],
    deps = [":wire"],
)
