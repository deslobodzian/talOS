{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "talOS Telemetry Studio",
  "version": "0.1.0",
  "identifier": "dev.talos.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "talOS · Telemetry Studio",
        "width": 1500,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp":
          "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws: wss: http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data: blob:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false
  }
}
