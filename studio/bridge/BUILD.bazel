load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

exports_files([
    "uws.BUILD.bazel",
    "usockets.BUILD.bazel",
])

# The system graph: what the live registry holds, as the JSON document Studio
# and agents consume. Separate from the bridge binary so it can be tested
# without a socket.
cc_library(
    name = "system",
    hdrs = ["system.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//talOS/introspection:names",
        "//talOS/introspection:registry",
    ],
)

# The telemetry feed's bridge side: page assembly, per-client change-only
# updates under the egress budget, and the JSON views. Header-only, like
# :system, so all of it can be tested without a socket.
cc_library(
    name = "telemetry",
    hdrs = ["telemetry.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":system",
        "//talOS/telemetry:frames",
        "//talOS/telemetry:schema",
        "@flatbuffers",
    ],
)

# The driver dashboard's feed (/drive): the reserved egress budget, the
# drive slots, the channel mask and the drive summary. Header-only, like
# :telemetry.
cc_library(
    name = "drive",
    hdrs = ["drive.h"],
    deps = [
        ":system",
        ":telemetry",
        "//talOS/introspection:registry",
        "//talOS/telemetry:dashboard_layout",
        "//talOS/telemetry:wire",
        "@nlohmann_json//:json",
    ],
)

cc_test(
    name = "drive_test",
    size = "small",
    srcs = ["tests/drive_test.cc"],
    deps = [
        ":drive",
        ":telemetry",
        "//talOS/introspection:registry",
        "//talOS/telemetry:dashboard_layout",
        "//talOS/telemetry:frames",
        "//talOS/telemetry:schema",
        "//talOS/telemetry:wire",
        "@flatbuffers",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "telemetry_test",
    size = "small",
    srcs = ["tests/telemetry_test.cc"],
    deps = [
        ":system",
        ":telemetry",
        "//talOS/introspection:registry",
        "//talOS/telemetry:frames",
        "//talOS/telemetry:schema",
        "@flatbuffers",
        "@googletest//:gtest_main",
    ],
)

# The system graph's golden files: a graph, the update the bridge sends at
# the next refresh, and that refresh's graph. :system_test requires the
# bridge to reproduce them byte for byte; //studio:system_test and
# :fast_slots_test apply the update in Studio's and the Python harness's
# fast-value order (README.md, "HTTP and WebSocket views").
# copy_to_bin, not rules_js's js_library: a robot repository builds
# :studio_bridge from this package, so it loads nothing from aspect_rules_js,
# a development dependency of talOS that a dependent module does not get.
# The copies sit in the output tree, where //studio's js_test reads data
# (it cannot copy another package's source files itself).
copy_to_bin(
    name = "golden",
    srcs = glob(["testdata/golden/*"]),
    visibility = ["//studio:__pkg__"],
)

cc_test(
    name = "system_test",
    size = "small",
    srcs = ["tests/system_test.cc"],
    data = glob(["testdata/golden/*"]),
    env = {"TALOS_GOLDEN_GRAPH": "$(rlocationpath testdata/golden/graph.json)"},
    deps = [
        ":system",
        # The `/hw/*` topic names, so a test that asserts on them cannot drift
        # from the strings the hardware bridge actually opens.
        "//talOS/hardware",
        "//talOS/introspection:names",
        "//talOS/introspection:registry",
        "@googletest//:gtest_main",
        "@rules_cc//cc/runfiles",
    ],
)

# The Python tests' shared helpers: a stdlib WebSocket client, the fast-value
# order and a bridge process's port and stop.
py_library(
    name = "bridge_client",
    testonly = True,
    srcs = ["bridge_client.py"],
)

# Hermetic: it imports only bridge_client's fast_slots.
py_test(
    name = "fast_slots_test",
    size = "small",
    srcs = ["fast_slots_test.py"],
    data = glob(["testdata/golden/*"]),
    deps = [":bridge_client"],
)

cc_binary(
    name = "studio_mock",
    srcs = ["mock.cc"],
    deps = [
        "//talOS/rtms",
        "//talOS/telemetry:frames",
        "//talOS/telemetry:schema",
        "//talOS/telemetry:wire",
        "@flatbuffers",
    ],
)

cc_binary(
    name = "studio_bridge",
    srcs = ["main.cc"],
    # A robot's talos_bundle carries it (studio_bridge), and the simulation
    # soak test launches it as a chaos target.
    visibility = ["//visibility:public"],
    deps = [
        ":drive",
        ":system",
        ":telemetry",
        "//talOS/configuration",
        "//talOS/introspection:describe",
        "//talOS/introspection:registry",
        "//talOS/process",
        "//talOS/rtms",
        "//talOS/rtms:wake",
        "//talOS/telemetry:dashboard_layout",
        "//talOS/telemetry:schema",
        "//talOS/telemetry:wire",
        "@flatbuffers",
        "@studio_uws//:uws",
        # internal/internal.h: the callback poll that puts the wake channel's
        # descriptor in the loop (main.cc WatchReadable).
        "@studio_usockets//:usockets",
    ],
)

py_test(
    name = "integration_test",
    srcs = ["integration_test.py"],
    data = [
        ":studio_bridge",
        ":studio_mock",
    ],
    tags = [
        "integration",
        "local",
    ],
    deps = [":bridge_client"],
)

py_test(
    name = "bandwidth_test",
    size = "medium",
    srcs = ["bandwidth_test.py"],
    data = [
        ":studio_bridge",
        ":studio_mock",
    ],
    tags = [
        "integration",
        "local",
    ],
    deps = [":bridge_client"],
)

# Runs the bridge at its smallest idle timeout (8 s), so it takes about 9 s.
py_test(
    name = "client_timeout_test",
    size = "medium",
    srcs = ["client_timeout_test.py"],
    data = [":studio_bridge"],
    tags = [
        "integration",
        "local",
    ],
    deps = [":bridge_client"],
)

# The stop with each kind of connection a browser or client can leave open.
py_test(
    name = "stop_test",
    size = "medium",
    srcs = ["stop_test.py"],
    data = [":studio_bridge"],
    # The 0.5 s stop bound is this test's (STOP_BOUND_S); TSan adds a nearly
    # constant per-process cost, and on the hosted macOS runner every case
    # stopped in 0.48 to 0.57 s (TODO.md CI-10). The bound holds plain and
    # under ASan, where these stops with open client connections still run.
    # TSan has nothing to find on them: the bridge runs one loop thread and
    # starts no other (no std::thread or pthread_create in studio/bridge or
    # its deps; uSockets runs on the calling thread), so its only concurrency
    # is the stop signal's handler, which talOS/process's tests cover.
    tags = [
        "integration",
        "local",
        "no_tsan",  # a wall-clock stop bound; the bridge has one thread
    ],
    deps = [":bridge_client"],
)

# A webroot whose pages were never built: the bridge runs and its pages name
# the build command.
py_test(
    name = "missing_pages_test",
    size = "small",
    srcs = ["missing_pages_test.py"],
    data = [":studio_bridge"],
    tags = [
        "integration",
        "local",
    ],
    deps = [":bridge_client"],
)

# A second listener on a port another holds: the bridge refuses it and exits.
py_test(
    name = "listen_test",
    size = "small",
    srcs = ["listen_test.py"],
    data = [":studio_bridge"],
    tags = [
        "integration",
        "local",
    ],
)

# --describe answers with no ports, shm, or robot, so this stays hermetic.
py_test(
    name = "describe_test",
    srcs = ["describe_test.py"],
    data = [
        "testdata/robot.toml",
        ":studio_bridge",
    ],
)
