load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

exports_files([
    "uws.BUILD.bazel",
    "usockets.BUILD.bazel",
])

# The system graph: what the live registry holds, as the JSON document Studio
# and agents consume. Separate from the bridge binary so it can be tested
# without a socket.
cc_library(
    name = "system",
    hdrs = ["system.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//talOS/introspection:names",
        "//talOS/introspection:registry",
    ],
)

# The telemetry JSON views: the latest v2 frame and its dictionary as
# self-describing documents. Header-only, like :system, so both can be
# tested without a socket.
cc_library(
    name = "telemetry",
    hdrs = ["telemetry.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":system",
        "//talOS/telemetry:schema",
        "@flatbuffers",
    ],
)

cc_test(
    name = "telemetry_test",
    size = "small",
    srcs = ["tests/telemetry_test.cc"],
    deps = [
        ":telemetry",
        "//talOS/telemetry:schema",
        "@flatbuffers",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "system_test",
    size = "small",
    srcs = ["tests/system_test.cc"],
    deps = [
        ":system",
        # The `/hw/*` topic names, so a test that asserts on them cannot drift
        # from the strings the hardware bridge actually opens.
        "//talOS/hardware",
        "//talOS/introspection:names",
        "//talOS/introspection:registry",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "studio_mock",
    srcs = ["mock.cc"],
    deps = [
        "//talOS/rtms",
        "//talOS/telemetry:schema",
        "//talOS/telemetry:wire",
        "@flatbuffers",
    ],
)

cc_binary(
    name = "studio_bridge",
    srcs = ["main.cc"],
    deps = [
        ":system",
        ":telemetry",
        "//talOS/configuration",
        "//talOS/introspection:describe",
        "//talOS/introspection:registry",
        "//talOS/rtms",
        "//talOS/telemetry:schema",
        "//talOS/telemetry:wire",
        "@flatbuffers",
        "@studio_uws//:uws",
    ],
)

py_test(
    name = "integration_test",
    srcs = ["integration_test.py"],
    data = [
        ":studio_bridge",
        ":studio_mock",
    ],
    tags = ["local"],
)

# --describe answers with no ports, shm, or robot, so this stays hermetic.
py_test(
    name = "describe_test",
    srcs = ["describe_test.py"],
    data = [
        "testdata/robot.toml",
        ":studio_bridge",
    ],
)
