load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")

exports_files([
    "uws.BUILD.bazel",
    "usockets.BUILD.bazel",
])

# The system graph: what the live registry holds, as the JSON document Studio
# and agents consume. Separate from the bridge binary so it can be tested
# without a socket.
cc_library(
    name = "system",
    hdrs = ["system.h"],
    visibility = ["//visibility:public"],
    deps = [
        "//talOS/introspection:names",
        "//talOS/introspection:registry",
    ],
)

# The telemetry feed's bridge side: page assembly, per-client change-only
# updates under the egress budget, and the JSON views. Header-only, like
# :system, so all of it can be tested without a socket.
cc_library(
    name = "telemetry",
    hdrs = ["telemetry.h"],
    visibility = ["//visibility:public"],
    deps = [
        ":system",
        "//talOS/telemetry:frames",
        "//talOS/telemetry:schema",
        "@flatbuffers",
    ],
)

cc_test(
    name = "telemetry_test",
    size = "small",
    srcs = ["tests/telemetry_test.cc"],
    deps = [
        ":system",
        ":telemetry",
        "//talOS/introspection:registry",
        "//talOS/telemetry:frames",
        "//talOS/telemetry:schema",
        "@flatbuffers",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "system_test",
    size = "small",
    srcs = ["tests/system_test.cc"],
    deps = [
        ":system",
        # The `/hw/*` topic names, so a test that asserts on them cannot drift
        # from the strings the hardware bridge actually opens.
        "//talOS/hardware",
        "//talOS/introspection:names",
        "//talOS/introspection:registry",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "studio_mock",
    srcs = ["mock.cc"],
    deps = [
        "//talOS/rtms",
        "//talOS/telemetry:frames",
        "//talOS/telemetry:schema",
        "//talOS/telemetry:wire",
        "@flatbuffers",
    ],
)

cc_binary(
    name = "studio_bridge",
    srcs = ["main.cc"],
    # The simulation soak test launches the bridge as a chaos target.
    visibility = ["//2026-robot/main_processor/simulation:__pkg__"],
    deps = [
        ":system",
        ":telemetry",
        "//talOS/configuration",
        "//talOS/introspection:describe",
        "//talOS/introspection:registry",
        "//talOS/rtms",
        "//talOS/rtms:wake",
        "//talOS/telemetry:schema",
        "//talOS/telemetry:wire",
        "@flatbuffers",
        "@studio_uws//:uws",
        # internal/internal.h: the callback poll that puts the wake channel's
        # descriptor in the loop (main.cc WatchReadable).
        "@studio_usockets//:usockets",
    ],
)

py_test(
    name = "integration_test",
    srcs = ["integration_test.py"],
    data = [
        ":studio_bridge",
        ":studio_mock",
    ],
    tags = ["local"],
)

py_test(
    name = "bandwidth_test",
    size = "medium",
    srcs = [
        "bandwidth_test.py",
        "integration_test.py",
    ],
    data = [
        ":studio_bridge",
        ":studio_mock",
    ],
    main = "bandwidth_test.py",
    tags = ["local"],
)

# --describe answers with no ports, shm, or robot, so this stays hermetic.
py_test(
    name = "describe_test",
    srcs = ["describe_test.py"],
    data = [
        "testdata/robot.toml",
        ":studio_bridge",
    ],
)
