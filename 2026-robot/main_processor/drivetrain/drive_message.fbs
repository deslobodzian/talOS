include "geometry/geometry.fbs";

namespace drivetrain;

// Robot-relative chassis request. x forward, y left, yaw CCW.
struct ChassisTarget {
  vx_mps:double;
  vy_mps:double;
  omega_radps:double;
}

// Published every drivetrain tick, valid or not.
//
// sample_time_ns: oldest node-clock signal acquisition time contributing to
// either valid product (modules or yaw); 0 when neither is valid.
// modules_valid: all module devices report, with known drive position/velocity
// and steer position times, each positive, not future, <=50 ms old and spanning
// <=20 ms. Values may still update while invalid; do not use them for odometry.
// yaw_valid: usable gyro yaw timing, or heading integrated from valid modules.
// Gyro yaw uses the same age bound; when valid modules and yaw together span
// >20 ms, modules take priority and yaw is invalid. See README.md for policy.
// Otherwise yaw_rad holds the last valid heading (0 before the first).
// vx/vy/omega: robot-relative chassis motion the modules measure.
// yaw_rad: field heading, CCW+.
// module0..3: accumulated wheel travel and azimuth per module, in
// [subsystems.drivetrain.geometry].modules order.
struct DrivetrainState {
  sample_time_ns:ulong;
  enabled:bool;
  modules_valid:bool;
  yaw_valid:bool;
  vx_mps:double;
  vy_mps:double;
  omega_radps:double;
  yaw_rad:double;
  module0:geometry.SwerveModulePosition;
  module1:geometry.SwerveModulePosition;
  module2:geometry.SwerveModulePosition;
  module3:geometry.SwerveModulePosition;
}
