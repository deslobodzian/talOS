namespace drivetrain;

// Robot-relative chassis request. x forward, y left, yaw CCW.
struct ChassisTarget {
  vx_mps:double;
  vy_mps:double;
  omega_radps:double;
  enabled:bool;
}

struct DrivetrainState {
  timestamp_ns:ulong;
  enabled:bool;
  vx_mps:double;
  vy_mps:double;
  omega_radps:double;
  yaw_rot:double;
  yaw_rate_rps:double;
}
