# The flags every workspace that builds talOS shares, this one included:
# a repository depending on talOS imports the same file.
import %workspace%/talos.bazelrc

# What follows is this checkout's own.

# Share compiled artifacts across worktrees, tools/prepush.sh, and tools/tidy.sh.
# Explicit --disk_cache flags (e.g. prepush.sh) and user ~/.bazelrc take precedence.
build --disk_cache=~/.cache/talos-bazel-disk
build --experimental_disk_cache_gc_max_size=40G

# --config=release records this checkout's revision (talos.bazelrc).
build:release --workspace_status_command=tools/workspace_status.sh

# --config=gcp: the bazel-remote cache VM in Google Cloud (scripts/README.md),
# for builds on a VM in its network (.github/workflows/ci-cd.yml). The address
# is the VM's reserved internal one, CACHE_IP in scripts/gcp-cicd.env.sh; it is
# not reachable from anywhere else. No disk cache: such a VM is deleted after
# one build, so a local copy of every output would never be read again.
build:gcp --remote_cache=grpc://10.10.0.10:9092
build:gcp --disk_cache=
build:gcp --remote_cache_compression
build:gcp --remote_upload_local_results=true
build:gcp --remote_timeout=60
