module(name = "talos_telemetry", version = "0.1.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "flatbuffers", version = "25.12.19")
bazel_dep(name = "talos", version = "0.1.0")
local_path_override(
    module_name = "talos",
    path = "..",
)
bazel_dep(name = "studio_schema", version = "0.1.0")
local_path_override(
    module_name = "studio_schema",
    path = "../studio-schema",
)
bazel_dep(name = "talos_driver_station", version = "0.1.0")
local_path_override(
    module_name = "talos_driver_station",
    path = "../talos-driver_station",
)
bazel_dep(name = "talos_odometry", version = "0.1.0")
local_path_override(
    module_name = "talos_odometry",
    path = "../talos-odometry",
)
# Neutral chassis frame contract (replaces the former year-local drivetrain
# messages edge): the telemetry core draws chassis channels from it.
bazel_dep(name = "talos_chassis_contracts", version = "0.1.0")
local_path_override(
    module_name = "talos_chassis_contracts",
    path = "../talos-chassis_contracts",
)
