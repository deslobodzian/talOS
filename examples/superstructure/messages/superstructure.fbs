namespace demo;

enum SuperstructureCommand : ubyte { STOW, INTAKE, SCORE_HIGH }

enum SuperstructureState : ubyte { STOWED, INTAKING, HOLDING, RAISING, SCORING }

// What the driver (or autonomous) asks for, on the lanes
// /superstructure/target/teleop (or /superstructure/target/auto). Republish
// it every period: no live goal (stale past [robot] command_timeout_us,
// released, or the robot disabled) counts as STOW.
struct SuperstructureGoal {
  command:SuperstructureCommand;
}

// The sequence step, on /superstructure/state.
struct SuperstructureStatus {
  state:SuperstructureState;
}
