load("@talos//talOS/build:contract.bzl", "talos_bundle", "talos_graph_test", "talos_sim", "talos_sim_test")
load("@talos//tools:sync_manifest.bzl", "manifest_sync_test")
load(":robot_manifest.bzl", "CONFIG_FILES", "NODES")

package(default_visibility = ["//visibility:public"])

exports_files(["robot.toml"] + glob(["subsystems/*.toml"]))

# The simulator robot.toml's [robot] sim_gateway names.
SIMULATOR = "@talos//talOS/simulation:sim_gateway"

# Fails, with the regenerate command, when robot_manifest.bzl is stale.
manifest_sync_test(
    name = "manifest_sync_test",
    config = "robot.toml",
    config_files = CONFIG_FILES,
    manifest = "robot_manifest.bzl",
)

# Runs every node with --describe and lints the graph, as
# `launcher --describe-only` does.
talos_graph_test(
    name = "graph_test",
    config = "robot.toml",
    data = CONFIG_FILES,
    nodes = NODES,
)

talos_bundle(
    name = "robot_bundle",
    config = "robot.toml",
    config_files = CONFIG_FILES,
    nodes = ["@talos//talOS/bridge:hardware_node"] + NODES,
)

# `bazel run //:sim -- [launcher arguments]` runs the robot against the
# simulator, e.g. `bazel run //:sim -- --duration-s 10`.
talos_sim(
    name = "sim",
    config = "robot.toml",
    data = CONFIG_FILES + [SIMULATOR],
    nodes = NODES,
)

# e2e: the robot runs against the simulator on free loopback ports until it
# is up, then 1 s more: every member runs once and exits 0, and the bridge
# receives State from the simulator (talos_sim_test,
# talOS/build/contract.bzl). Takes its startup plus 1 s of real time.
talos_sim_test(
    name = "sim_smoke_test",
    sim = ":sim",
)
