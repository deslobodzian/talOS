namespace roller;

// What a producer asks for on its lane, /roller/target/<source>. The node
// drives the motor only while the robot is enabled and a lane of its target
// policy is live.
struct RollerTarget {
  velocity_rps:double;
}

// What the roller is doing, published every tick.
struct RollerState {
  enabled:bool;
  velocity_rps:double;
  connected:bool;
}
