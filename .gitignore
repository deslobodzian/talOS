# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo

# Bazel stuff
bazel-*

# hedron_compile_commands output
compile_commands.json
/external

# Python bytecode
__pycache__/
*.py[cod]

# The standalone example repositories pin talOS by local_path_override, so
# their module lockfiles would change with every talOS MODULE.bazel edit.
examples/*/MODULE.bazel.lock

# Agent scratch (plans, session notes, worktrees)
.agents/*
!.agents/agents/
!.agents/rules/
!.agents/skills/
.claude/*
!.claude/agents/
