namespace EventsTest;

// Sensor reading published into the loop under test.
struct SensorMessage {
    sensor_id:int;
    position_rot:float;
    velocity_rps:float;
}

// SensorMessage's size and layout under another name and field: input replay
// must refuse it on a topic recorded as SensorMessage.
struct OtherSensorMessage {
    sensor_id:int;
    position_rot:float;
    speed_rps:float;
}

// Operator setpoint; the robot keeps the latest one.
struct SetpointMessage {
    setpoint_id:int;
    target_rot:float;
}

// What the control loop produces. Replay compares these byte for byte.
struct CommandMessage {
    command_id:int;
    effort_v:float;
    cycle_count:ulong;
}
