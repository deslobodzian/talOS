namespace control;

// Standard velocity command for rollers, flywheels, and conveyor mechanisms.
// Sent on a target lane (talos::TargetLane), whose envelope says whether it
// is active.
struct VelocityTarget {
  velocity_rps:double;
  feedforward_v:double;
}

// Standard velocity feedback published by velocity-controlled mechanisms.
struct VelocityState {
  velocity_rps:double;
  requested_rps:double;
  current_a:double;
  enabled:bool;
  connected:bool;
}

// Standard position/motion-magic command for wrists, elevators, and turrets.
struct PositionTarget {
  position_rot:double;
  feedforward_v:double;
}

// Standard position feedback with goal echo and tolerance indicator.
struct PositionState {
  position_rot:double;
  velocity_rps:double;
  goal_rot:double;
  enabled:bool;
  at_goal:bool;
  connected:bool;
}
