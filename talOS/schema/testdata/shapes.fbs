// Fixtures for //talOS/schema:schema_hash_test and schema_hash_py_test.
namespace schema_test;

enum Mode : ubyte { OFF, LOW = 3, HIGH }

enum Level : short { BOTTOM = -1, NONE, TOP = 300 }

struct Inner {
  mode:Mode;
  offset_m:float;
}

// Mixed alignment: 1-, 8-, 2-, 4-byte fields, a nested struct and padding.
struct Mixed {
  flag:bool;
  position_m:double;
  level:Level;
  sample_count:uint;
  inner:Inner;
  speed_frac:float;
}

// Fixed-length arrays of scalars, enums and structs.
struct Arrays {
  samples_m:[double:3];
  modes:[Mode:2];
  inners:[Inner:2];
  channel_id:[ubyte:5];
}

// Alert fields (talOS/introspection/names.h, ParseAlertField), one of each
// level beside a plain field and an index the telemetry labels test names.
struct Alerts {
  alert_error_link_lost:bool;
  alert_warning_hot:bool;
  alert_info_homed:bool;
  routine_index:ubyte;
  supply_v:double;
}

// For the graph lint: an alert that is not a bool, an `alert_` field of no
// level, and well-formed alerts nested one struct down.
struct BadAlerts {
  alert_error_fault_count:uint;
  alert_fatal_overheat:bool;
  nested:Alerts;
}
