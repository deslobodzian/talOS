// float_level.fbs with Reading forced to 16-byte alignment: identical field
// names, types and offsets, larger trailing padding (bytesize 8 -> 16,
// minalign 4 -> 16).
namespace schema_variant;

enum Kind : ubyte { RAW, FILTERED }

struct Reading (force_align: 16) {
  level_m:float;
  kind:Kind;
  ok:bool;
}

struct Holder {
  reading:Reading;
}
