load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cpu_apriltag_backend",
    srcs = ["cpu_apriltag_backend.cc"],
    hdrs = ["cpu_apriltag_backend.h"],
    deps = [
        "//talOS/geometry",
        "//talOS/process",
        "//talOS/vision:calibration",
        "//talOS/vision:localization",
        "//third_party:apriltag",
        "@eigen3//:eigen",
        "@opencv//:imgcodecs",
    ],
)

# Shared OpenCV fixture loader for detector tests (testonly).
cc_library(
    name = "test_image_loader",
    testonly = True,
    hdrs = ["test_image_loader.h"],
    deps = [
        "@apriltag",
        "@opencv//:imgcodecs",
    ],
)

cc_test(
    name = "cpu_apriltag_backend_test",
    size = "small",
    srcs = ["cpu_apriltag_backend_test.cc"],
    data = [
        "//talOS/vision/testdata",
    ],
    deps = [
        ":cpu_apriltag_backend",
        ":test_image_loader",
        "//talOS/geometry",
        "//talOS/process",
        "//third_party:apriltag",
        "@googletest//:gtest",
        "@googletest//:gtest_main",
    ],
)

test_suite(
    name = "...",
    tests = [":cpu_apriltag_backend_test"],
)
