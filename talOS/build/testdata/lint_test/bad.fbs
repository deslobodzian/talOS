// Field-name lint fixture (//talOS/build:descriptor_gen_lint_test):
// speed_bad, count (a suffix needs a name before it) and samples_bad (an
// array of numbers) lack a unit suffix; every other field passes.
namespace lint_test;

enum Color : ubyte { RED, GREEN }

struct Inner {
  width_m:float;
}

struct Bad {
  speed_bad:double;
  count:ulong;
  samples_bad:[float:2];
  enabled:bool;
  color:Color;
  colors:[Color:2];
  inner:Inner;
  inners:[Inner:2];
  position_m:double;
  mode_index:ubyte;
  temperature_degc:float;
}
