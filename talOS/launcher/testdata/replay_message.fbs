// replay_inputs_test's topics.
namespace replay_inputs_test;

// /replay_source/state: one reading per tick.
struct Reading {
  reading_index:uint;
  position_m:float;
}

// Reading's size and layout under another name: a reader of
// /replay_source/state that expects it is refused.
struct Impostor {
  reading_index:uint;
  distance_m:float;
}

// /replay_motor/state: its motor as the devices layer reads it each tick;
// sample_time_ns is -1 while HardwareLink::sample_time() has no value.
struct MotorReading {
  connected:bool;
  position_rot:double;
  sample_time_ns:long;
}

// /replay_consumer/state: what the consumer made of every reading so far.
struct Summary {
  reading_count:uint;
  total_m:float;
}
