namespace bridge;

// The program running the gateway, as its State reports it
// (hardware::GatewayProgram; the values match, and a new one comes with a
// protocol version bump, since an older decoder rejects it).
enum GatewayProgram : ubyte {
  UNKNOWN,
  ROBORIO,
  ROBORIO_SIMULATION,
  SIM_GATEWAY,
}

// The hardware bridge's health, published by hardware_node on /hw/status every
// 20 ms. The counters are cumulative since the bridge started.
//
// state_age_us is the bridge's monotonic now minus the moment it accepted the
// last /hw/state frame from the RoboRIO (bridge clock on both sides), and 0
// before the first frame. states_received_count counts every decoded frame,
// dropped ones included. timed_out_mask has bit i set when the i-th
// actuator-owning subsystem, in sorted name order, has timed out; only the
// first 32 fit. subsystem_count is the number of those subsystems.
// configured is whether the RoboRIO acknowledged this bridge's configuration.
//
// clock_offset_us maps gateway sample time to node time. Valid only after
// eight ordered States and a causal two-way probe exchange of this boot.
// clock_offset_uncertainty_us bounds absolute mapping error assuming
// nonnegative transport delay and <=1000 ppm relative oscillator drift.
// clock_min_round_trip_us includes gateway residence and bridge scheduling.
// Exchanges expire after one second; spread remains a one-way variability
// diagnostic, never an accuracy bound. No fusion accuracy threshold is
// specified, so uncertainty is reported rather than arbitrarily gated.
// Resets count new boots; ignored counts reordered/retired States dropped whole.
// HardwareLink::sample_time() applies this mapping.
struct BridgeStatus {
  states_received_count:uint64;
  commands_sent_count:uint64;
  identity_rejected_count:uint64;
  ownership_rejected_count:uint64;
  driver_station_packet_count:uint64;
  state_age_us:uint64;
  timed_out_mask:uint32;
  subsystem_count:uint32;
  configured:bool;
  clock_boot_id:uint64;
  clock_offset_us:int64;
  clock_offset_spread_us:uint64;
  clock_resets_count:uint64;
  clock_ignored_count:uint64;
  clock_window_count:uint32;
  clock_offset_valid:bool;
  health_valid:bool;
  battery_v:double;
  brownout:bool;
  can_utilization_frac:double;
  // Bit i (configured motor order): invalid feedback or controller fault flags
  // other than an asserted soft or hard limit (hardware::MotorFaulted).
  motor_fault_mask:uint32;
  // Bit i (configured motor order): a valid sample reports the TalonFX's
  // forward (reverse) hardware limit switch asserted
  // (hardware::kMotorForwardHardLimitFlag, kMotorReverseHardLimitFlag), so it
  // holds output that way neutral. Normal at the end of travel; a bit that
  // stays set away from it is a normally closed switch with a cut wire.
  motor_forward_limit_mask:uint32;
  motor_reverse_limit_mask:uint32;
  gateway_rejected_command_count:uint32;
  gateway_neutralized_motor_count:uint32;
  gateway_apply_failure_count:uint32;
  gateway_device_reset_count:uint32;
  // The gateway build of the last accepted State (hardware::GatewayBuild),
  // UNKNOWN and 0 before the first: the program, whether it was built with
  // uncommitted changes, and the first 16 hex digits of its git commit read
  // as one number (0 when unknown; print it with %016llx).
  gateway_program:GatewayProgram;
  gateway_build_dirty:bool;
  gateway_build_id:uint64;
  // Causal two-way bound, including residence time, quantization and 1000 ppm
  // relative oscillator drift. Local logs only (excluded from robot radio).
  clock_offset_uncertainty_us:uint64;
  clock_min_round_trip_us:uint64;
}
