load("@rules_cc//cc:defs.bzl", "cc_library")

# WPILib C++ from the Maven release artifacts (extensions.bzl). Shared
# libraries: a binary linking these finds libwpimath/libwpiutil through
# Bazel's runfiles rpaths, and a robot bundle stages them under lib/
# (talOS/build/contract.bzl).

exports_files(["extensions.bzl"])

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

cc_library(
    name = "wpiutil",
    visibility = ["//visibility:public"],
    deps = ["@wpilib_wpiutil_headers//:headers"] + select({
        "@platforms//os:macos": ["@wpilib_wpiutil_osxuniversal//:lib"],
        ":linux_x86_64": ["@wpilib_wpiutil_linuxx86_64//:lib"],
        ":linux_aarch64": ["@wpilib_wpiutil_linuxarm64//:lib"],
    }),
)

# wpimath: geometry, kinematics, estimators, units (`#include <frc/...>`,
# `<units/...>`).
cc_library(
    name = "wpimath",
    visibility = ["//visibility:public"],
    deps = [
        ":wpiutil",
        "@wpilib_wpimath_headers//:headers",
    ] + select({
        "@platforms//os:macos": ["@wpilib_wpimath_osxuniversal//:lib"],
        ":linux_x86_64": ["@wpilib_wpimath_linuxx86_64//:lib"],
        ":linux_aarch64": ["@wpilib_wpimath_linuxarm64//:lib"],
    }),
)
