diff -r a/include/toml++/impl/parser.inl b/include/toml++/impl/parser.inl
--- a/include/toml++/impl/parser.inl	2026-11-07 19:30:46.630434725 -0500
+++ b/include/toml++/impl/parser.inl	2026-11-07 19:30:46.642587358 -0500
@@ -3151,6 +3151,13 @@
 				if (*cp == U']')
 					set_error_and_return_default("tables with blank bare keys are explicitly prohibited"sv);
 
+				// talos patch: parse_key() assumes a key-start character; reject
+				// anything else as a parse error instead of asserting (UB under NDEBUG).
+				if (!is_bare_key_character(*cp) && !is_string_delimiter(*cp))
+					set_error_and_return_default("expected bare key starting character or string delimiter, saw '"sv,
+												 to_sv(*cp),
+												 "'"sv);
+
 				// get the actual key
 				start_recording();
 				parse_key();
diff -r a/include/toml++/impl/unicode_autogenerated.hpp b/include/toml++/impl/unicode_autogenerated.hpp
--- a/include/toml++/impl/unicode_autogenerated.hpp	2026-11-07 19:35:40.071285759 -0500
+++ b/include/toml++/impl/unicode_autogenerated.hpp	2026-11-07 19:35:40.083308998 -0500
@@ -41,7 +41,9 @@
 			case 0x05: return c == U'\u1680' || c == U'\u180E';
 			case 0x07:
 				return (U'\u2000' <= c && c <= U'\u200B') || (U'\u205F' <= c && c <= U'\u2060') || c == U'\u202F';
-			default: TOML_UNREACHABLE;
+			// talos patch: the mask above leaves buckets 0, 11 and 63 (e.g. U+00B1 '±')
+			// unfiltered; they contain no other whitespace, so this is not unreachable.
+			default: return false;
 		}
 
 		TOML_UNREACHABLE;
