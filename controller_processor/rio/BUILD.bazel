load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":rio_sources.bzl", "rio_stage_manifest")

# Note: the Gradle wrapper script `gradlew` shares the name of the :gradlew
# py_binary below, so gradlew_runner.py stages it from the talOS root beside
# MODULE.bazel rather than listing it here (which would create a label cycle).
_RIO_PROJECT_FILES = [
    ".wpilib/wpilib_preferences.json",
    "build.gradle",
    "gradlew.bat",
    "settings.gradle",
    "simgui-ds.json",
    "tsan_suppressions.txt",
] + glob([
    "gradle/**",
    "src/**",
    "vendordeps/**",
])

rio_stage_manifest(
    name = "rio_stage_manifest",
    srcs = _RIO_PROJECT_FILES,
    module_file = "//:MODULE.bazel",
    talos_deps = [
        "//talOS/driver_station",
        "//talOS/driver_station:schedule",
        "//talOS/hardware",
        "//talOS/hardware:config",
        "//talOS/process:durable_sync",
        "//talOS/protocol",
    ],
)

# Runs GradleRIO on a staged cache copy of controller_processor/rio and the
# talOS sources its build.gradle reads, without mutating the talOS checkout or
# Bazel execroot. From a robot repository:
#   bazel run @talos//controller_processor/rio:gradlew -- deploy -Pcompanion=<ipv4>
py_binary(
    name = "gradlew",
    srcs = ["gradlew_runner.py"],
    data = [
        ":rio_stage_manifest",
        "//:MODULE.bazel",
    ],
    main = "gradlew_runner.py",
    visibility = ["//visibility:public"],
    deps = ["@rules_python//python/runfiles"],
)

# Over 5 s: stages controller_processor/rio and invokes the GradleRIO
# daemon/wrapper (6.5 s on Linux CI); integration lane.
py_test(
    name = "gradlew_test",
    size = "small",
    srcs = ["gradlew_test.py"],
    data = [":gradlew"],
    env = {
        "RIO_GRADLEW": "$(rlocationpath :gradlew)",
    },
    tags = ["integration"],
    deps = ["@rules_python//python/runfiles"],
)

# The RoboRIO program builds with GradleRIO, not Bazel. Keep its WPILib
# release aligned with the Python wpimath native wheels and bindings.
py_test(
    name = "wpilib_lockstep_test",
    size = "small",
    srcs = ["wpilib_lockstep_test.py"],
    data = [
        "build.gradle",
        "//talOS/python:requirements.txt",
    ],
    deps = ["@rules_python//python/runfiles"],
)

# REQ-RT-24: the RoboRIO loop (Robot.cpp) makes no Driver Station NetComm call.
py_test(
    name = "rio_loop_netcomm_test",
    size = "small",
    srcs = ["rio_loop_netcomm_test.py"],
    data = ["src/main/cpp/Robot.cpp"],
    env = {
        "RIO_ROBOT_CPP": "$(rlocationpath src/main/cpp/Robot.cpp)",
    },
    deps = ["@rules_python//python/runfiles"],
)
